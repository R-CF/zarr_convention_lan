{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zarr-conventions/lan/refs/heads/main/schema.json",
  "title": "Language localisation convention for Zarr",
  "description": "Multilingual free text for Zarr attributes, encoding the ISO 19115-1 language localization package.",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "description": "Zarr format version"
    },
    "node_type": {
      "type": "string",
      "enum": ["array", "group"],
      "description": "Type of Zarr node"
    },
    "attributes": {
      "type": "object",
      "description": "Zarr attributes containing convention metadata and properties",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          }
        },
        "$ref": "#/$defs/lanAttributes"
      },
      "required": ["zarr_conventions"]
    }
  },
  "required": ["zarr_format", "node_type", "attributes"],
  "$defs": {
    "lanAttributes": {
      "type": "object",
      "properties": {
        "lan:defaultLocale": {
          "$ref": "#/$defs/defaultLocale"
        },
        "lan:otherLocale": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/otherLocale"
          }
        },
        "lan:freeText": {
          "$ref": "#/$defs/freeText"
        }
      },
      "required": ["lan:defaultLocale"],
      "dependentRequired": {
        "lan:freeText": ["lan:otherLocale"],
        "lan:otherLocale": ["lan:freeText"]
      }
    },
    "conventionMetadata": {
      "type": "object",
      "description": "Template convention metadata object for use in zarr_conventions array",
      "properties": {
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/R-CF/zarr_convention_lan/refs/heads/main/schema.json",
          "description": "URL to the JSON Schema definition for this convention"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/R-CF/zarr_convention_lan/refs/heads/main/README.md",
          "description": "URL to the full specification document"
        },
        "uuid": {
          "type": "string",
          "const": "6df0d0c6-c26e-4580-94e9-7c6adff481a4",
          "description": "UUID that permanently identifies this convention"
        },
        "name": {
          "type": "string",
          "const": "lan"
        },
        "description": {
          "type": "string",
          "const": "Multilingual attribute values based on ISO 19115-1 PT_Locale and PT_FreeText"
        }
      },
      "anyOf": [
        {
          "required": ["schema_url"]
        },
        {
          "required": ["spec_url"]
        },
        {
          "required": ["uuid"]
        }
      ],
      "additionalProperties": false
    },
    "locale": {
      "description": "ISO/TR 19115-4 PT_Locale, constrained to the codes used by this convention, plus the optional script extension.",
      "allOf": [
        {
          "$ref": "https://schemas.isotc211.org/json/19115/-4/mdj/1.0.0/mdj.json#PT_Locale"
        },
        {
          "type": "object",
          "properties": {
            "language": {
              "description": "ISO 639-2/T alpha-3 code; ISO 639-3 where no ISO 639-2 code exists",
              "type": "string",
              "pattern": "^[a-z]{3}$"
            },
            "country": {
              "description": "ISO 3166-1 alpha-2 code",
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "characterEncoding": {
              "description": "Zarr JSON metadata is always UTF-8",
              "const": "utf8"
            },
            "script": {
              "description": "Extension: ISO 15924 alpha-4 script code",
              "type": "string",
              "pattern": "^[A-Z][a-z]{3}$"
            }
          }
        }
      ]
    },
    "defaultLocale": {
      "allOf": [
        { "$ref": "#/$defs/locale" },
        {
          "not": {
            "required": ["id"]
          }
        }
      ]
    },
    "otherLocale": {
      "allOf": [
        {
          "$ref": "#/$defs/locale"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/localeId"
            }
          },
          "required": ["id"]
        }
      ]
    },
    "localeId": {
      "description": "Extension (as PT_Locale/@id in ISO 19115-3): identifier of the locale within this node",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "freeText": {
      "description": "PT_FreeText: attribute name -> locale id -> localised string",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "not": {
          "anyOf": [
            { "pattern": "^lan:" },
            { "const": "zarr_conventions" }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/localeId"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
